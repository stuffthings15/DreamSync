<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_moon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ds_cream"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dreams Redefined."
                    android:textColor="@color/ds_muted"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="AUTOMATIC NIGHTS"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/powerStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="OFF — NOT MONITORING"
                android:textColor="@color/ds_danger"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/readinessText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Turn On once. DreamSync watches for sleep every night until you turn it Off."
                android:textColor="@color/ds_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="DreamSync is Off."
                android:textColor="@color/ds_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/powerButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="Turn DreamSync On"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/openWatchButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Set up watch app"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice" />

            </LinearLayout>

            <Button
                android:id="@+id/systemCheckButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_outline"
                android:stateListAnimator="@null"
                android:text="Run watch system check"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="SLEEP PROTECTION"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/modeDeep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:checked="true"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Protect sleep only (recommended)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/modeLucid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Experimental watch sound (requires 7 baseline nights)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/modeCombined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text=""
                    android:visibility="gone"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/gainLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Cue volume: 4%"
                android:textColor="@color/ds_text"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/gainSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="10"
                android:min="1"
                android:progress="4"
                android:progressTint="@color/ds_indigo"
                android:thumbTint="@color/ds_violet" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Keep cues barely audible. One cue-linked wake sign stops cues for the night."
                android:textColor="@color/ds_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/previewDeepButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Test phone fallback"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice" />

                <Button
                    android:id="@+id/practiceLucidButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text=""
                    android:visibility="gone"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="YOUR DATA"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/morningButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="Morning check-in"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/historyButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:text="History"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:text="Export"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice" />

                <Button
                    android:id="@+id/deleteDataButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_danger"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_danger" />
            </LinearLayout>

            <Button
                android:id="@+id/exportDebugButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="Export debug log"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />

            <Button
                android:id="@+id/sleepProtectionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="Sleep protection &amp; coaching"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />

            <Button
                android:id="@+id/compatibilityButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="Watch compatibility"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />

            <Button
                android:id="@+id/scienceButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="How it works &amp; research"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />

            <Button
                android:id="@+id/privacyButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_outline"
                android:text="Privacy &amp; safety"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Research-shaped, not clinically proven. DreamSync uses wrist estimates, not EEG. It is not a medical device."
            android:textColor="@color/ds_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
