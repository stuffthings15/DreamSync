<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_moon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ds_cream"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="Sleep-cue research prototype"
                    android:textColor="@color/ds_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="STATUS"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Phone audio is not armed."
                android:textColor="@color/ds_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Protocol card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="PROTOCOL"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/modeSensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Sensor-only / sham (no cues)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/modeDeep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:checked="true"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Deep cues (early-night NREM)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/modeLucid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Lucid cue (late-night REM)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/modeCombined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/ds_indigo"
                    android:paddingStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="Combined (separated windows)"
                    android:textColor="@color/ds_text"
                    android:textSize="15sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/ds_card_line" />

            <CheckBox
                android:id="@+id/dryRunCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ds_violet"
                android:paddingStart="8dp"
                android:text="Accelerated test run — verify cues fire while awake, without waiting a full night. Do not sleep with this on."
                android:textColor="@color/ds_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cue volume card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="CUE VOLUME"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gainLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cue gain: 4% (also set phone media volume low)"
                android:textColor="@color/ds_text"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/gainSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="20"
                android:min="1"
                android:progress="4"
                android:progressTint="@color/ds_indigo"
                android:thumbTint="@color/ds_violet" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lie down, play a test cue, lower it until barely audible, then go one step lower."
                android:textColor="@color/ds_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/testDeepButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Test deep cue"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/testLucidButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Practice lucid chime"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Night session card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="NIGHT SESSION"
                android:textColor="@color/ds_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/armButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="Arm phone audio + send settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/openWatchButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:stateListAnimator="@null"
                    android:text="Open on watch"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_ice"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_danger"
                    android:stateListAnimator="@null"
                    android:text="Stop session"
                    android:textAllCaps="false"
                    android:textColor="@color/ds_danger"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Watch deploy card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.12"
                    android:text="DEPLOY WATCH APP"
                    android:textColor="@color/ds_violet"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/watchHelpButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="How?"
                    android:textColor="@color/ds_indigo"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1"
                android:textColor="@color/ds_indigo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On the watch: Settings ▸ System ▸ About ▸ tap Build number 7 times."
                android:textColor="@color/ds_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="2"
                android:textColor="@color/ds_indigo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developer options ▸ turn on ADB debugging and Debug over Wi-Fi. Same Wi-Fi as this phone."
                android:textColor="@color/ds_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="3"
                android:textColor="@color/ds_indigo"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type the IP:port the watch shows, then install."
                android:textColor="@color/ds_text"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/watchAddressInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_selector"
                android:hint="192.168.1.42:5555"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/ds_text"
                android:textColorHint="#5A6187"
                android:textSize="15sp" />

            <Button
                android:id="@+id/deployWatchButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_outline"
                android:stateListAnimator="@null"
                android:text="Install watch app over Wi-Fi"
                android:textAllCaps="false"
                android:textColor="@color/ds_ice"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tonight: keep the phone 50–100 cm from the pillow. The watch estimates probable sleep states from motion and heart rate; it does not measure EEG or diagnose sleep stages."
            android:textColor="@color/ds_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
